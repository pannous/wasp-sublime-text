%YAML 1.2
---
# wasp / warp: https://github.com/pannous/wasp, the Rust implementation ~/dev/angles/warp (its parser is the reference).
# The word lists between the GENERATED marks come from warp's sources: rerun scripts/update_words.py, don't edit them.
name: Wasp
file_extensions:
  - a
  - an
  - ang
  - angl
  - angle
  - wasp
  - warp
first_line_match: ^#!.*\b(wasp|warp)\b
scope: source.wasp

variables:
  identifier: '[A-Za-z_][A-Za-z0-9_]*'
  # `-` ends a word: `a-1` is a subtraction
  word_end: '(?![A-Za-z0-9_])'
  word_start: '(?<![A-Za-z0-9_$@&])'
  # BEGIN GENERATED by scripts/update_words.py
  # from warp's sources, see SOURCES in scripts/update_words.py; rerun instead of editing
  constant_language: (?:nothing|empty|euler|false|nada|nill|none|null|true|void|nil|nix|nul|tau|yes|no|pi)
  constant_language_glyphs: (?:⚠️|⚡️|✓️|ø|ε|π|τ|ω|ℯ|ⅈ|∞|⊤|⊥|⊨|⊭|☑|⚡|✅|✓|✔|❌|🗸|🗹)
  keyword_control: (?:continue|default|assert|elseif|except|return|switch|unless|await|break|catch|elsif|match|raise|throw|until|while|yield|case|elif|else|loop|once|then|with|end|for|try|do|go|if|in)
  keyword_function: (?:function|define|func|def|fun|fn)
  keyword_declaration: (?:capability|interface|prototype|typeclass|protocol|feature|aspect|record|struct|class|trait|data|enum)
  keyword_import: (?:include|require|import|use)
  storage_modifier: (?:synchronized|thread_local|constexpr|protected|transient|abstract|constant|external|internal|nonlocal|override|volatile|mutable|private|virtual|atomic|export|extern|global|inline|native|public|shared|static|const|final|let|mut|val|var)
  keyword_operator_word: (?:approximately|interpret|undefined|contains|effects|missing|unknown|absent|failed|circa|times|cbrt|even|nand|sqrt|upto|abs|all|and|div|has|mod|not|odd|rem|xor|as|be|by|is|of|or|to)
  keyword_operator_word_glyphs: (?:±|²|³|·|‐|‑|‒|–|—|―|‖|−|√|∛|∧|∨|≈|≟|≡|⊻|⊼|⋀|⋁|⋅|﹦)
  storage_type: (?:codepoint|duration|rational|boolean|closure|complex|integer|String|double|option|result|string|symbol|array|error|exact|float|tuple|bool|byte|char|date|fast|list|long|node|real|text|any|f32|f64|i16|i32|i64|int|map|set|str|u16|u32|u64|i8|u8)
  support_function: (?:is_alphanumeric|round_half_even|round_half_up|random_below|starts_with|byte_slice|codepoint|ends_with|is_letter|lowercase|uppercase|download|includes|index_of|is_alnum|is_alpha|is_digit|is_error|byte_at|isalnum|isalpha|isdigit|ordinal|println|replace|reverse|warning|append|filter|insert|length|random|reduce|remove|unwrap|values|chars|clock|clone|count|error|first|floor|items|lower|print|range|round|sleep|slice|split|strip|upper|ceil|copy|each|exit|find|fold|join|keys|last|push|puts|read|size|sort|trim|type|add|any|chr|cos|exp|get|hex|len|log|map|max|min|now|ord|pop|sin|sum|tan|ln)
  time_units: (?:minutes|seconds|minute|months|second|hours|month|weeks|years|days|hour|week|year|day)
  units: (?:millisecond|centimeter|characters|codepoints|millimeter|kilometer|milligram|kilogram|bytes|meter|metre|gram|AD|cm|kg|km|mg|mm|ms|g|h|m|s)
  # END GENERATED

contexts:
  main:
    - include: statements

  statements:
    - include: comments
    - include: strings
    - include: numbers
    - include: groups
    - include: definitions
    - include: keys
    - include: words
    - include: operators

  ##############################################################################
  # comments: `// …` (not glued to an operand: `7//2` divides, `http://` is no comment), `# …` at a line start
  # (also `#!`, `##`, `#use …`), and nesting `/* … */` and `/# … #/`

  comments:
    - match: '(?<![A-Za-z0-9_)\]:])//'
      scope: punctuation.definition.comment.wasp
      push: line_comment
    - match: '^\s*(#)(?=[ \t!#]|$|(?:{{keyword_import}}){{word_end}})'
      captures:
        1: punctuation.definition.comment.wasp
      push: line_comment
    - match: '/\*'
      scope: punctuation.definition.comment.begin.wasp
      push: star_block_comment
    - match: '/#'
      scope: punctuation.definition.comment.begin.wasp
      push: hash_block_comment

  line_comment:
    - meta_scope: comment.line.wasp
    - match: '$\n?'
      pop: true

  star_block_comment:
    - meta_scope: comment.block.wasp
    - match: '\*/'
      scope: punctuation.definition.comment.end.wasp
      pop: true
    - match: '/\*'
      push: star_block_comment

  hash_block_comment:
    - meta_scope: comment.block.wasp
    - match: '#/'
      scope: punctuation.definition.comment.end.wasp
      pop: true
    - match: '/#'
      push: hash_block_comment

  ##############################################################################
  # strings: "…" interpolates (`$name`, `${expr}`, `\(expr)`), '…' does not; both escape (`\n`, `\u{e9}`, `\:alpha`);
  # a one-character literal is a codepoint whichever quote it uses; `p's name` is possessive, no quote

  strings:
    - match: "(?<=[A-Za-z0-9_])'s(?= [A-Za-z_])"
      scope: keyword.operator.possessive.wasp
    - match: '"(?:[^"\\$]|\\.)"'
      scope: string.quoted.double.wasp constant.character.codepoint.wasp
    - match: "'(?:[^'\\\\]|\\\\.)'"
      scope: string.quoted.single.wasp constant.character.codepoint.wasp
    - match: '"'
      scope: punctuation.definition.string.begin.wasp
      push: double_quoted
    - match: "'"
      scope: punctuation.definition.string.begin.wasp
      push: single_quoted
    - match: '«'
      scope: punctuation.definition.string.begin.wasp
      push: guillemet_quoted

  escapes:
    - match: '\\u\{\h+\}|\\:[A-Za-z]+|\\.'
      scope: constant.character.escape.wasp

  double_quoted:
    - meta_scope: string.quoted.double.wasp
    - match: '"'
      scope: punctuation.definition.string.end.wasp
      pop: true
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.wasp
      push: brace_interpolation
    - match: '\\\('
      scope: punctuation.section.interpolation.begin.wasp
      push: paren_interpolation
    - match: '\$\$'
      scope: constant.character.escape.wasp
    - match: '\${{identifier}}'
      scope: variable.other.interpolated.wasp
    - include: escapes

  brace_interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.wasp
    - match: '\}'
      scope: punctuation.section.interpolation.end.wasp
      pop: true
    - include: statements

  paren_interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.wasp
    - match: '\)'
      scope: punctuation.section.interpolation.end.wasp
      pop: true
    - include: statements

  single_quoted:
    - meta_scope: string.quoted.single.wasp
    - match: "'"
      scope: punctuation.definition.string.end.wasp
      pop: true
    - include: escapes

  guillemet_quoted:
    - meta_scope: string.quoted.other.wasp
    - match: '[»«]'
      scope: punctuation.definition.string.end.wasp
      pop: true
    - include: escapes

  ##############################################################################
  # numbers: 0x1F, 1_000, 3.14, 1e9, ⅓-style ratios via `/`, ordinals (1st), and units right after (3km, 1000 ms, 2 minutes)

  numbers:
    - match: '{{word_start}}(0[xX]\h[\h_]*|0[bB][01][01_]*|(?:\d[\d_]*(?:\.\d[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d+)?)(?:(st|nd|rd|th){{word_end}}|\s*((?:{{units}}|{{time_units}}){{word_end}}))?'
      captures:
        1: constant.numeric.wasp
        2: constant.numeric.suffix.ordinal.wasp
        3: keyword.other.unit.wasp

  ##############################################################################

  groups:
    - match: '\('
      scope: punctuation.section.group.begin.wasp
      push:
        - meta_scope: meta.group.wasp
        - match: '\)'
          scope: punctuation.section.group.end.wasp
          pop: true
        - include: statements
    - match: '\['
      scope: punctuation.section.brackets.begin.wasp
      push:
        - meta_scope: meta.brackets.wasp
        - match: '\]'
          scope: punctuation.section.brackets.end.wasp
          pop: true
        - include: statements
    - match: '\{'
      scope: punctuation.section.block.begin.wasp
      push:
        - meta_scope: meta.block.wasp
        - match: '\}'
          scope: punctuation.section.block.end.wasp
          pop: true
        - include: statements
    - match: '[)\]}]'
      scope: invalid.illegal.stray-bracket-end.wasp

  ##############################################################################
  # definitions: `def square x`, `fn f(x)`, `class Point`, getters `area := w*h`, `f(x) := …`, tags `Person { … }`

  definitions:
    - match: '{{word_start}}((?:{{keyword_function}}))\s+({{identifier}})'
      captures:
        1: keyword.declaration.function.wasp
        2: entity.name.function.wasp
    - match: '{{word_start}}((?:{{keyword_declaration}}))\s+({{identifier}})'
      captures:
        1: keyword.declaration.wasp
        2: entity.name.type.wasp
    - match: '{{word_start}}({{identifier}})(?=\s*(?:\([^()]*\)\s*)?:=)'
      scope: entity.name.function.wasp
    - match: '(?:^|(?<=[:=(,\[{]))\s*(?!(?:{{keyword_control}}|{{keyword_function}}|{{keyword_declaration}}|{{storage_modifier}}){{word_end}})({{identifier}})(?=\s*\{)'
      captures:
        1: entity.name.tag.wasp

  # keys: `name: "Alice"`, not `::` or `:=`, not control words (`else: …`)
  keys:
    - match: '{{word_start}}(?!(?:{{keyword_control}}){{word_end}})({{identifier}})\s*(:)(?![:=])'
      captures:
        1: entity.name.key.wasp
        2: punctuation.separator.key-value.wasp

  ##############################################################################

  words:
    - match: '{{word_start}}(?i:{{constant_language}}){{word_end}}'
      scope: constant.language.wasp
    - match: '{{constant_language_glyphs}}'
      scope: constant.language.wasp
    - match: '{{word_start}}(?:{{keyword_control}}){{word_end}}'
      scope: keyword.control.wasp
    - match: '{{word_start}}(?:{{keyword_function}}){{word_end}}'
      scope: keyword.declaration.function.wasp
    - match: '{{word_start}}(?:{{keyword_declaration}}){{word_end}}'
      scope: keyword.declaration.wasp
    - match: '{{word_start}}(?:{{keyword_import}}){{word_end}}'
      scope: keyword.control.import.wasp
    - match: '{{word_start}}(?:{{storage_modifier}}){{word_end}}'
      scope: storage.modifier.wasp
    - match: '{{word_start}}(?:{{keyword_operator_word}}){{word_end}}'
      scope: keyword.operator.word.wasp
    - match: '{{keyword_operator_word_glyphs}}'
      scope: keyword.operator.wasp
    # `xs.map(f)`, `map(xs, f)`: a call of a word that also names a type (`map`, `text`) is the function
    - match: '(?<=\.)(?:{{support_function}}){{word_end}}|{{word_start}}(?:{{support_function}})(?=\()'
      scope: support.function.builtin.wasp
    - match: '{{word_start}}(?:{{storage_type}}){{word_end}}'
      scope: storage.type.wasp
    - match: '{{word_start}}(?:{{support_function}}){{word_end}}'
      scope: support.function.builtin.wasp
    - match: '{{word_start}}it{{word_end}}'
      scope: variable.language.wasp
    - match: '\$(?:{{identifier}}|\d+)'
      scope: variable.parameter.wasp
    - match: '@{{identifier}}'
      scope: entity.other.attribute-name.wasp
    - match: '&(?={{identifier}})'
      scope: keyword.operator.function-reference.wasp
    - match: '{{word_start}}{{identifier}}(?=\()'
      scope: variable.function.wasp

  ##############################################################################

  operators:
    - match: ':='
      scope: keyword.operator.definition.wasp
    - match: '\|>|\|(?!\|)'
      scope: keyword.operator.pipe.wasp
    - match: '!!?(?!=)'
      scope: keyword.operator.run.wasp
    - match: '\?\.|\?\?|::|\.\.\.?|->|=>'
      scope: keyword.operator.wasp
    - match: '(?:[-+*/%^]|\*\*|&&|\|\||<<|>>)='
      scope: keyword.operator.assignment.augmented.wasp
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.wasp
    - match: '='
      scope: keyword.operator.assignment.wasp
    - match: '&&|\|\|'
      scope: keyword.operator.logical.wasp
    - match: '\+\+|--|\*\*|//|[-+*/%^×÷]'
      scope: keyword.operator.arithmetic.wasp
    - match: '[#?:]'
      scope: keyword.operator.wasp
    - match: '[,;]'
      scope: punctuation.separator.wasp
    - match: '\.'
      scope: punctuation.accessor.wasp
